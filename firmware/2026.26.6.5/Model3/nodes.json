    "RCM": {
        "boot_message_name": "RCM_bootID",
        "data_upload": "rcm_protocol",
        "data_upload_limit": 40,
        "data_upload_limit_dev": 40,
        "force_auto_data_upload": true,
        "minimum_power_state": "ACCESSORY_PLUS",
        "odj_sources": [
            "RCM_custom.odj",
            "COMMON_custom.odj"
        ],
        "request_message_name": "UDS_rcmRequest",
        "response_message_name": "RCM_udsResponse",
        "security": {
            "algorithm": "pektron_hash",
            "buffer_size": 3,
            "kw": {
                "fixed_bytes": "6E6164616D"
            }
        },
        "variant_group": {
            "node_name": "RCM",
            "qualifier": {
                "file": "/var/etc/restraintshwtype",
                "parser": "text_value",
                "values": [
                    "21",
                    "22",
                    "23"
                ]
            }
        }
    },
